{
	"schemaVersion": 1,
	"id": "ghostskin",
	"version": "${version}",
	"name": "Ghost Skin",
	"description": "A very simple mod that allows player skins to have transparency.",
	"authors": [
		"Isabel Maskrey"
	],
	"license": "CC0-1.0",
	"icon": "assets/ghostskin/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.satyrn.ghostskin.GhostSkinMod"
		],
		"client": [
			"dev.satyrn.ghostskin.client.GhostSkinModClient"
		]
	},
	"mixins": [
		{
			"config": "ghostskin.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
